do
	local rawKey = iskeypressed
	local vk = {
		[0xA0] = 304,
		[0xA1] = 303,
		[0xA2] = 306,
		[0xA3] = 305,
		[0x10] = 304,
		[0x11] = 306,
		[0x12] = 307,
		[0x21] = 280,
		[0x22] = 281,
		[0x23] = 279,
		[0x24] = 278,
		[0x25] = 263,
		[0x26] = 265,
		[0x27] = 262,
		[0x28] = 264,
		[0x2D] = 277,
		[0x2E] = 261,
	}
	local function down(id)
		if type(rawKey) ~= "function" then
			return false
		end
		local ok, hit = pcall(rawKey, id)
		return ok and hit and true or false
	end
	iskeypressed = function(code)
		local n = tonumber(code)
		if not n then
			return false
		end
		if down(n) then
			return true
		end
		if vk[n] and down(vk[n]) then
			return true
		end
		if n >= 65 and n <= 90 and down(n + 32) then
			return true
		end
		if n >= 0x70 and n <= 0x7B and down(n + 170) then
			return true
		end
		return false
	end
end

local Ins
do
	local src
	pcall(function()
		src = game:HttpGet("https://raw.githubusercontent.com/neaxusxgod-png/INS-ui/main/uilib.min.lua")
	end)
	if type(src) ~= "string" or #src < 200 then
		pcall(function()
			src = httpget("https://raw.githubusercontent.com/neaxusxgod-png/INS-ui/main/uilib.min.lua")
		end)
	end
	if type(src) == "string" and #src > 200 then
		src = src:gsub('AddKey%("RightShift", 0xA1%)', 'AddKey("RightShift", 303) AddKey("rightshift", 303) AddKey("rshift", 303)')
		src = src:gsub('AddKey%("LeftShift", 0xA0%)', 'AddKey("LeftShift", 304) AddKey("leftshift", 304) AddKey("lshift", 304)')
		src = src:gsub('AddKey%("Shift", 0x10%)', 'AddKey("Shift", 304) AddKey("shift", 304)')
		src = src:gsub('AddKey%("LeftCtrl", 0xA2%)', 'AddKey("LeftCtrl", 306) AddKey("leftctrl", 306) AddKey("lctrl", 306)')
		src = src:gsub('AddKey%("RightCtrl", 0xA3%)', 'AddKey("RightCtrl", 305) AddKey("rightctrl", 305) AddKey("rctrl", 305)')
		src = src:gsub('AddKey%("Ctrl", 0x11%)', 'AddKey("Ctrl", 306) AddKey("ctrl", 306)')
		local fn, err = loadstring(src)
		if fn then
			local ok, lib = pcall(fn)
			if ok then
				Ins = lib
			else
				print("INS-ui run fail", lib)
			end
		else
			print("INS-ui compile fail", err)
		end
	else
		print("INS-ui download fail")
	end
end
Ins = Ins or INSUI

local uiWindow

local function grabService(id)
	local ok, svc = pcall(function()
		return game:GetService(id)
	end)
	if ok and svc then
		return svc
	end
	ok, svc = pcall(function()
		return game[id]
	end)
	if ok then
		return svc
	end
	return nil
end

local Players = grabService("Players")
local Workspace = workspace or grabService("Workspace")
local RunService = grabService("RunService")
local UserInputService = grabService("UserInputService")
local LocalPlayer = Players and Players.LocalPlayer
local lp = LocalPlayer
local cam = Workspace and Workspace.CurrentCamera

